    {
      "parameters": {
        "jsCode": "const completedJobs = [];\n\ntry {\n    const ifNodeItems = $('If').all();\n\n    for (const item of ifNodeItems) {\n\n        if (item.json && item.json.output) {\n\n            completedJobs.push({\n                json: {\n                    title: item.json.output.title || \"No Title\",\n                    company: item.json.output.company || \"\",\n                    match_score: item.json.output.match_score || \"N/A\",\n                    short_summary: item.json.output.short_summary || \"\",\n                    apply_url: item.json.output.apply_url || \"\",\n                    should_apply: item.json.output.should_apply || \"No\",\n                    reason: item.json.output.reason || \"\"\n                }\n            });\n\n        }\n    }\n\n} catch (e) {\n    return [{\n        json: {\n            error: e.message\n        }\n    }];\n}\n\nreturn completedJobs;"
      },
